  users                users?    @relation(fields: [seller_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([seller_id], map: "idx_invoice_items_seller_id")
}

model invoices {
  id                     String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id              String           @db.Uuid
  client_id              String?          @db.Uuid
  cash_session_id        String?          @db.Uuid
  total_amount           Decimal          @default(0) @db.Decimal(10, 2)
  tip_amount             Decimal?         @default(0) @db.Decimal(10, 2)
  status                 String           @default("paid") @db.VarChar(20)
  created_at             DateTime         @default(now()) @db.Timestamptz(6)
  updated_at             DateTime         @default(now()) @db.Timestamptz(6)
  admin_fee_rate_at_sale Decimal?         @db.Decimal
  appointment_id         String?          @db.Uuid
  opened_by_user_id      String?          @db.Uuid
  client_name_adhoc      String?          @db.VarChar(255)
  closed_at              DateTime?        @db.Timestamptz(6)
  tip_recipient_user_id  String?          @db.Uuid
  cash_movements         cash_movements[]
  invoice_items          invoice_items[]
  cash_sessions          cash_sessions?   @relation(fields: [cash_session_id], references: [id], onUpdate: NoAction)
  users                  users?           @relation("invoices_client", fields: [client_id], references: [id], onUpdate: NoAction)
  opened_by_user         users?           @relation("invoices_opened_by", fields: [opened_by_user_id], references: [id], onUpdate: NoAction)
  tip_recipient          users?           @relation("invoices_tip_recipient", fields: [tip_recipient_user_id], references: [id], onUpdate: NoAction)
  tenants                tenants          @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  appointment            appointments?    @relation(fields: [appointment_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  payments               payments[]

  @@index([tenant_id, status], map: "idx_invoices_tenant_status")
  @@index([appointment_id], map: "idx_invoices_appointment")
}

model payments {
  id                 String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
