generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This table contains exclusion constraints and requires additional setup for migrations. Visit https://pris.ly/d/exclusion-constraints for more info.
model appointments {
  id                                   String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id                            String?    @db.Uuid
  client_id                            String?    @db.Uuid
  stylist_id                           String?    @db.Uuid
  service_id                           String?    @db.Uuid
  start_time                           DateTime   @db.Timestamptz(6)
  end_time                             DateTime   @db.Timestamptz(6)
  status                               String?    @default("scheduled") @db.VarChar(50)
  created_at                           DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at                           DateTime?  @default(now()) @db.Timestamptz(6)
  reminder_sent_1h                     Boolean?   @default(false)
  reminder_sent_24h                    Boolean?   @default(false)
  batch_id                             String?    @db.Uuid
  users_appointments_client_idTousers  users?     @relation("appointments_client_idTousers", fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  services                             services?  @relation(fields: [service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_appointments_stylist_idTousers users?     @relation("appointments_stylist_idTousers", fields: [stylist_id], references: [id], onUpdate: NoAction)
  tenants                              tenants?   @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payments                             payments[]
  invoices                             invoices[]

  @@index([status], map: "idx_appt_status")
  @@index([stylist_id, start_time, end_time], map: "idx_appt_stylist_time")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cash_movements {
  id                  String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id           String         @db.Uuid
  user_id             String?        @db.Uuid
  related_user_id     String?        @db.Uuid
  type                String         @db.VarChar(50)
  description         String
  amount              Decimal        @db.Decimal(10, 2)
  created_at          DateTime?      @default(now()) @db.Timestamptz(6)
  related_entity_type String?        @db.VarChar(64)
  related_entity_id   String?        @db.Uuid
  payment_method      String?        @db.VarChar(32)
  purpose             String?        @db.VarChar(64)
  category            String?
  invoice_ref         String?
  cash_session_id     String?        @db.Uuid
  invoice_id          String?        @db.Uuid
  status              String         @default("pending") @db.VarChar(20)
  edited_by_user_id   String?        @db.Uuid
  edited_at           DateTime?      @db.Timestamptz(6)
  edit_reason         String?        @db.VarChar(255)
  original_amount     Decimal?       @db.Decimal(10, 2)
  cash_sessions       cash_sessions? @relation(fields: [cash_session_id], references: [id], onUpdate: NoAction)
  invoices            invoices?      @relation(fields: [invoice_id], references: [id], onUpdate: NoAction)

  @@index([cash_session_id], map: "idx_cash_movements_cash_session_id")
  @@index([related_entity_type, related_entity_id], map: "idx_cash_movements_related_entity")
  @@index([tenant_id, created_at], map: "idx_cash_movements_tenant_created")
  @@index([tenant_id, type, created_at], map: "idx_cash_movements_tenant_type_created")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cash_sessions {
  id                                           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                                    String           @db.Uuid
  status                                       String           @db.VarChar(20)
  opened_at                                    DateTime         @default(now()) @db.Timestamptz(6)
  opened_by_user_id                            String           @db.Uuid
  initial_amount                               Decimal          @default(0) @db.Decimal(12, 2)
  closed_at                                    DateTime?        @db.Timestamptz(6)
  closed_by_user_id                            String?          @db.Uuid
  final_amount_counted                         Decimal?         @db.Decimal(12, 2)
  expected_cash_amount                         Decimal?         @db.Decimal(12, 2)
  difference                                   Decimal?         @db.Decimal(12, 2)
  notes                                        String?
  created_at                                   DateTime         @default(now()) @db.Timestamptz(6)
  updated_at                                   DateTime         @default(now()) @db.Timestamptz(6)
  cash_movements                               cash_movements[]
  users_cash_sessions_closed_by_user_idTousers users?           @relation("cash_sessions_closed_by_user_idTousers", fields: [closed_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_cash_sessions_opened_by_user_idTousers users            @relation("cash_sessions_opened_by_user_idTousers", fields: [opened_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenants                                      tenants          @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invoices                                     invoices[]
  payments                                     payments[]

  @@index([tenant_id, status], map: "idx_cash_sessions_tenant_id_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
